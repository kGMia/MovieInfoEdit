    "About Description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An elegant batch .NFO file editor developed for macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élégant éditeur de fichiers .NFO par lots conçu pour macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 向けのエレガントなバッチ .NFO ファイルエディタ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款专为 macOS 打造的优雅批量 .NFO 文件编辑器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款專為 macOS 打造的優雅批量 .NFO 文件編輯器。"
