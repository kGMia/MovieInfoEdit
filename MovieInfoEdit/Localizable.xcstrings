    "Files Changed Since Preview" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files changed since preview. Refresh the preview, or restore manually to avoid overwriting newer edits."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers ont changé. Actualisez l’aperçu ou restaurez manuellement pour préserver les modifications récentes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルが変更されました。プレビューを更新するか、後の編集を上書きしないよう手動で復元してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件已发生变化，请刷新预览；撤销时请手动核对，避免覆盖后续修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案已變更，請重新整理預覽；還原時請手動核對，避免覆寫後續修改。"
          }
        }
      }
    },
    "Folder Access Unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder access is unavailable. Import the media folder to grant read and write access, and check that the drive is connected and writable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès au dossier indisponible. Importez-le pour autoriser la lecture et l’écriture, puis vérifiez le disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダにアクセスできません。フォルダを読み込んで権限を付与し、ドライブの接続と書き込み権限を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问文件夹。请导入媒体所在文件夹以授予读写权限，并确认硬盘已连接且可写入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法存取檔案夾。請匯入媒體所在檔案夾以授予讀寫權限，並確認硬碟已連接且可寫入。"
          }
        }
      }
    },
