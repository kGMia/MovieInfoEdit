    "Batch Changes Hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only fields you change will be applied to all selected videos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les champs modifiés seront appliqués à toutes les vidéos sélectionnées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更した項目のみ、選択したすべての動画に適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅将本次修改的字段应用到所有选中视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅將本次修改的欄位套用到所有選取影片。"
          }
        }
      }
    },
    "Cache Hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app records directors, genres and actors for quick autocomplete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app enregistre les réalisateurs, genres et actors pour la saisie automatique."
