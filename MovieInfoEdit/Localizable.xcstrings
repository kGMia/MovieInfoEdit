    "Grant access to this media folder so MovieInfoEdit can read existing .nfo files and artwork next to the selected videos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grant access to this media folder so MovieInfoEdit can read existing .nfo files and artwork next to the selected videos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à ce dossier multimédia pour que MovieInfoEdit puisse lire les fichiers .nfo et les illustrations à côté des vidéos sélectionnées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した動画と同じ場所にある既存の .nfo ファイルやアートワークを MovieInfoEdit が読み取れるように、このメディアフォルダへのアクセスを許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请授予此媒体文件夹的访问权限，以便 MovieInfoEdit 读取所选视频旁边已有的 .nfo 文件和封面图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請授予此媒體資料夾的存取權限，讓 MovieInfoEdit 讀取所選影片旁已有的 .nfo 檔案和封面圖片。"
          }
        }
      }
    },
